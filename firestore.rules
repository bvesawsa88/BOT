rules_version = '2';
// เข้าถึง Firestore ผ่านเซิร์ฟเวอร์ (server.js + service account) เท่านั้น
// เบราว์เซอร์ไม่อ่าน/เขียน Firestore ตรง → ปิดทุกอย่างฝั่ง client
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
